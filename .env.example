# SEC automated access should identify the researcher and provide contact information.
# An organization is not required for independent research. Example:
# SEC_USER_AGENT="Anish Saripella Corporate Financial Deterioration Research your.email@example.com"
SEC_USER_AGENT="Your Name Research Project your.email@example.com"

# Request a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY="replace-with-your-free-fred-key"

# Optional overrides. Defaults are defined in configs/project.yml.
CFD_DATA_DIR="data"
CFD_DUCKDB_PATH="data/processed/cfd.duckdb"
